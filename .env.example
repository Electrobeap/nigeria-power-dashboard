FLASK_DEBUG=0
LOG_LEVEL=INFO

# Render PostgreSQL provides DATABASE_URL automatically when attached.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Local fallback if DATABASE_URL is not set.
GRID_SQLITE_PATH=data/grid_history.sqlite3

HISTORY_CAPTURE_ENABLED=1
HISTORY_CAPTURE_INTERVAL_SECONDS=1800
HISTORY_CAPTURE_ON_STARTUP=1
ANALYTICS_CACHE_TTL_SECONDS=120
RUN_MIGRATIONS_ON_STARTUP=1
AUTO_CREATE_TABLES=1

GRID_SOURCE_TIMEOUT_SECONDS=12
GRID_SCRAPER_RETRIES=2
GRID_SCRAPER_BACKOFF_SECONDS=1.5
GRID_CACHE_TTL_SECONDS=60
ROLLING_AVERAGE_WINDOW=12
APP_BASE_URL=https://nigeriapowerdata.com

DISTRIBUTION_POWER_FACTOR=0.9
TRANSFORMER_BASE_UTILIZATION=0.82
TRANSFORMER_WARNING_UTILIZATION_PERCENT=85
TRANSFORMER_OVERLOAD_UTILIZATION_PERCENT=95
SETTLEMENT_GROWTH_BASE_PERCENT=3.8
